---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { blogPostingSchema } from '../lib/seo';
import { findMyPapers } from '../lib/publications';
import PublicationCard from '../components/PublicationCard.astro';
import { postLang, postUrl, postVersions, type Post } from '../lib/blog';
import { useTranslations, localizePath, locales, languages, type Lang } from '../i18n/ui';

type Props = {
  post: Post;
};

const { post } = Astro.props;
const { Content } = await post.render();
const lang = postLang(post);
const t = useTranslations(lang);
const blogHome = localizePath('/blog/', lang);

// Other language versions of this post (for the notice, the switcher and hreflang)
const versions = await postVersions(post);
const otherVersions = (Object.entries(versions) as [Lang, string][]).filter(([l]) => l !== lang);

// My papers behind this post, as publication cards
const myPapers = await findMyPapers(post.data.papers);

const categoryColors = {
  'research-update': 'bg-pink-100 text-pink-700 dark:bg-pink-900 dark:text-pink-300',
  tutorial: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900 dark:text-cyan-300',
};
---

<style is:global>
  .prose {
    font-size: 1.05rem !important;
    line-height: 1.5 !important;
  }

  .prose p {
    margin-bottom: 0.75rem !important;
  }

  .prose ul {
    list-style-type: disc !important;
    padding-left: 1.5rem !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1.5rem !important;
  }

  .prose ol {
    list-style-type: decimal !important;
    padding-left: 1.5rem !important;
    margin-top: 1.5rem !important;
    margin-bottom: 1.5rem !important;
  }

  .prose ul > li,
  .prose ol > li {
    margin-top: 0.75rem !important;
    margin-bottom: 0.75rem !important;
    padding-left: 0.5rem !important;
    display: list-item !important;
  }

  .prose ul > li > p,
  .prose ol > li > p {
    margin-bottom: 0.5rem !important;
  }

  .prose a {
    color: #0d9488 !important;
    text-decoration: none !important;
  }

  .prose a:hover {
    text-decoration: underline !important;
  }

  .dark .prose a {
    color: #5eead4 !important;
  }

  /* Center display math equations */
  .prose .katex-display {
    text-align: center !important;
    margin: 1.5em 0 !important;
  }

  /* Center paragraphs containing display math */
  .prose p:has(> span.katex > span.katex-mathml > math[display="block"]) {
    text-align: center !important;
  }

  /* Center paragraphs that only contain katex (display equations) */
  .prose p:has(> span.katex:only-child) {
    text-align: center !important;
  }

  /* Table styling */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
  }

  .prose thead {
    border-bottom: 2px solid #94a3b8;
  }

  .prose th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    color: #0f172a !important;
    background-color: transparent;
  }

  .prose td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    color: #334155 !important;
    background-color: transparent;
  }

  .dark .prose thead {
    border-bottom-color: #475569;
  }

  .dark .prose th,
  .dark .prose td {
    color: #ffffff !important;
  }

  .dark .prose td {
    border-bottom-color: #334155;
  }

  .prose tbody tr {
    background-color: transparent;
  }

  .prose tbody tr:hover {
    background-color: transparent;
  }
</style>

<BaseLayout
  title={`${post.data.title} | Daniel Peláez-Zapata`}
  description={post.data.description}
  image={post.data.image}
  pubDate={post.data.pubDate}
  type="article"
  translations={versions}
  jsonLd={blogPostingSchema({
    lang,
    title: post.data.title,
    description: post.data.description,
    url: new URL(postUrl(post), Astro.site).href,
    pubDate: post.data.pubDate,
    image: post.data.image,
    tags: post.data.tags,
    paperUrl: post.data.paperUrl,
  })}
>
  <Header alternates={versions} />

  <main class="pt-20 bg-white dark:bg-slate-900 min-h-screen">
    <article class="container mx-auto px-4 py-12">
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-10">
          <a
            href={blogHome}
            class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 mb-6 text-sm font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            {t('blog.back')}
          </a>

          <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4">
            {post.data.title}
          </h1>

          <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase ${categoryColors[post.data.category]} mb-4`}>
            {t(`blog.cat.${post.data.category}`)}
          </span>

          <p class="text-lg text-slate-600 dark:text-slate-400 mb-4">
            {post.data.description}
          </p>

          <div class="flex items-center gap-4 text-sm text-slate-600 dark:text-slate-400">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString(locales[lang], {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
          </div>

          {post.data.tags && post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-4">
              {post.data.tags.map((tag) => (
                <span class="px-3 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-sm rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}

          {otherVersions.map(([l, url]) => (
            <a
              href={url}
              hreflang={l}
              lang={l}
              class="mt-6 flex items-center gap-2 rounded-lg border border-blue-200 dark:border-blue-800 bg-blue-50 dark:bg-blue-950/40 px-4 py-3 text-sm font-medium text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900/40 transition-colors"
            >
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m5 8 6 6M4 14l6-6 2-3M2 5h12M7 2h1M22 22l-5-10-5 10M14 18h6" />
              </svg>
              {useTranslations(l)('blog.readIn')}
              <span class="sr-only">({languages[l]})</span>
            </a>
          ))}
        </header>

        <!-- Featured Image -->
        {post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-64 md:h-96 object-cover rounded-lg shadow-lg mb-10"
          />
        )}

        <!-- Content -->
        <div class="prose prose-lg dark:prose-invert max-w-none
                    prose-headings:text-slate-900 dark:prose-headings:text-white prose-headings:font-bold
                    prose-p:text-slate-700 dark:prose-p:text-slate-300
                    prose-li:text-slate-700 dark:prose-li:text-slate-300
                    prose-strong:text-slate-900 dark:prose-strong:text-white
                    prose-a:text-teal-600 dark:prose-a:text-teal-400 prose-a:no-underline hover:prose-a:underline
                    prose-img:rounded-lg
                    prose-code:text-sm prose-code:bg-slate-100 dark:prose-code:bg-slate-800 prose-code:text-slate-800 dark:prose-code:text-slate-200 prose-code:px-1 prose-code:py-0.5 prose-code:rounded
                    prose-pre:bg-slate-900 dark:prose-pre:bg-slate-950 prose-pre:text-slate-100">
          <Content />
        </div>

        {myPapers.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">
              {t(myPapers.length > 1 ? 'blog.papers' : 'blog.paper')}
            </h2>
            <div class="grid gap-6">
              {myPapers.map((pub) => <PublicationCard pub={pub} lang={lang} />)}
            </div>
          </section>
        )}

        <!-- Navigation -->
        <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-700">
          <a
            href={blogHome}
            class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            {t('blog.backAll')}
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
