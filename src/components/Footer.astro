---
import { getLang, useTranslations } from '../i18n/ui';
const t = useTranslations(getLang(Astro.url));
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'Email',
    outline: true, // stroke icon: filling it turns it into a solid shape
    href: 'mailto:dspelaez@ifremer.fr',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    name: 'GitHub',
    href: 'https://github.com/dspelaez',
    icon: 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z'
  },
  {
    name: 'Google Scholar',
    href: 'https://scholar.google.com/citations?user=Usm9u2AAAAAJ&hl=en',
    icon: 'M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z'
  },
  {
    name: 'ORCID',
    href: 'https://orcid.org/0000-0001-5862-6194',
    icon: 'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z'
  },
];
---

<footer class="bg-slate-50 dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700">
  <div class="container mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <!-- Copyright -->
      <p class="text-sm text-slate-600 dark:text-slate-400">
        © {currentYear} Daniel Peláez-Zapata. {t('footer.rights')}
      </p>

      <!-- Social Links -->
      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-600 dark:text-slate-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            aria-label={link.name}
            title={link.name}
          >
            <svg
              class="w-6 h-6"
              viewBox="0 0 24 24"
              fill={link.outline ? 'none' : 'currentColor'}
              stroke={link.outline ? 'currentColor' : undefined}
              stroke-width={link.outline ? 2 : undefined}
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={link.icon} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Built with -->
    <div class="mt-4 text-center">
      <p class="text-xs text-slate-600 dark:text-slate-400">
        {t('footer.builtWith')} <a href="https://astro.build" class="hover:text-blue-600 dark:hover:text-blue-400">Astro</a> {t('footer.and')} <a href="https://tailwindcss.com" class="hover:text-blue-600 dark:hover:text-blue-400">Tailwind CSS</a>
      </p>
    </div>
  </div>
</footer>
