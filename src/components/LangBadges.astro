---
/**
 * EN · ES · FR badges on a blog card: one per language the article exists in,
 * always in that order and with the same style on every page. Each links to
 * that version of the post.
 */
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  versions: Partial<Record<Lang, string>>;
  current: Lang;
}

const { versions, current } = Astro.props;
const order: Lang[] = ['en', 'es', 'fr'];
const style = 'px-2 py-1 rounded-full text-xs font-semibold border transition-colors border-slate-300 dark:border-slate-600 text-slate-500 dark:text-slate-400 hover:border-blue-500 hover:text-blue-600 dark:hover:border-blue-400 dark:hover:text-blue-400';
---

{order.filter((l) => versions[l]).map((l) => (
  <a
    href={versions[l]}
    lang={l}
    hreflang={l}
    title={useTranslations(l)('blog.readIn')}
    aria-current={l === current ? 'true' : undefined}
    class={style}
  >{l.toUpperCase()}</a>
))}
