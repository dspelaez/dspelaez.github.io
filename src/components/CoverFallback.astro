---
/**
 * Cover shown on blog cards when a post has no `image`: a gradient by category
 * with a soft wave pattern and an icon, so every card keeps the same layout.
 */
interface Props {
  category: 'research-update' | 'tutorial';
}

const { category } = Astro.props;
const gradient =
  category === 'tutorial'
    ? 'from-teal-500 via-cyan-700 to-slate-900'
    : 'from-sky-500 via-blue-700 to-slate-900';
---

<div class={`relative w-full h-48 overflow-hidden bg-gradient-to-br ${gradient}`} aria-hidden="true">
  <svg class="absolute inset-0 w-full h-full text-white/15" viewBox="0 0 400 200" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M0 120 Q 50 100 100 120 T 200 120 T 300 120 T 400 120" />
    <path d="M0 145 Q 50 125 100 145 T 200 145 T 300 145 T 400 145" />
    <path d="M0 170 Q 50 150 100 170 T 200 170 T 300 170 T 400 170" />
    <path d="M0 95 Q 50 75 100 95 T 200 95 T 300 95 T 400 95" />
  </svg>
  <div class="absolute inset-0 flex items-center justify-center text-white/80">
    {category === 'tutorial' ? (
      <svg class="w-14 h-14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />
      </svg>
    ) : (
      <svg class="w-14 h-14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
        <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
        <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
        <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" />
      </svg>
    )}
  </div>
</div>
