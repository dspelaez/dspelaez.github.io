---
const navItems = [
  { name: 'About', href: '/#about' },
  { name: 'Publications', href: '/#publications' },
  { name: 'Projects', href: '/projects' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/#contact' },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo/Name -->
      <a href="/" class="flex items-center gap-2 text-xl font-bold text-white hover:text-blue-400 transition-all duration-300 header-text hover-scale">
        <img src="/favicon.png" alt="Logo" class="w-8 h-8 transition-transform duration-300 hover:rotate-12" />
        <span>Daniel Peláez-Zapata</span>
      </a>

      <div class="flex items-center gap-2 md:gap-6">
        <!-- Desktop Navigation -->
        <ul class="hidden md:flex items-center gap-6">
          {navItems.map((item, index) => (
            <li class="animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
              <a
                href={item.href}
                class="text-white/90 hover:text-blue-400 transition-all duration-300 font-medium header-text relative group"
              >
                {item.name}
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 transition-all duration-300 group-hover:w-full"></span>
              </a>
            </li>
          ))}
        </ul>

        <!-- Light/dark toggle: shows the moon in light mode and the sun in dark mode -->
        <button
          id="theme-toggle"
          type="button"
          class="p-2 rounded-full text-white/90 hover:text-blue-400 header-text transition-all duration-300 hover-scale"
          aria-label="Switch between light and dark mode"
          title="Switch between light and dark mode"
        >
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
          </svg>
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          class="md:hidden p-2 text-white/90 hover:text-blue-400 header-text transition-all duration-300 hover-scale"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pt-4 border-t border-slate-200 dark:border-slate-700 transition-all duration-300">
      <ul class="flex flex-col gap-3">
        {navItems.map((item, index) => (
          <li class="animate-fade-in" style={`animation-delay: ${index * 0.05}s`}>
            <a
              href={item.href}
              class="block text-slate-600 hover:text-blue-600 transition-all duration-300 font-medium py-2 header-text hover:translate-x-2"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  // Theme toggle (the initial theme is set in BaseLayout before the page paints)
  const themeToggle = document.getElementById('theme-toggle');
  themeToggle?.addEventListener('click', () => {
    const dark = !document.documentElement.classList.contains('dark');
    document.documentElement.classList.toggle('dark', dark);
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      // Storage unavailable (private mode): the choice lasts for this page only
    }
  });

  // Mobile menu toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking a link
  const mobileLinks = menu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });

  // Header scroll effect
  const header = document.getElementById('main-header');
  const headerTexts = document.querySelectorAll('.header-text');

  // Pages without the video hero have a plain background from the top,
  // so the header needs its solid style straight away
  const hasHero = Boolean(document.getElementById('hero'));

  const solidHeader = ['bg-white/95', 'dark:bg-slate-900/95', 'backdrop-blur-sm', 'border-b', 'border-slate-200', 'dark:border-slate-700', 'shadow-sm'];
  const solidText = ['text-slate-800', 'dark:text-slate-100', 'hover:text-blue-600', 'dark:hover:text-blue-400'];
  const heroText = ['text-white', 'text-white/90', 'hover:text-blue-400'];

  function updateHeader() {
    const solid = window.scrollY > 50 || !hasHero;
    solidHeader.forEach(c => header?.classList.toggle(c, solid));
    headerTexts.forEach(el => {
      el.classList.remove('text-slate-600', ...(solid ? heroText : solidText));
      el.classList.add(...(solid ? solidText : heroText));
    });
  }

  // Initial check
  updateHeader();

  // Listen to scroll events
  window.addEventListener('scroll', updateHeader);
</script>
