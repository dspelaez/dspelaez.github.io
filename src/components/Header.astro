---
const navItems = [
  { name: 'About', href: '#about' },
  { name: 'Publications', href: '#publications' },
  { name: 'Projects', href: '#projects' },
  { name: 'Blog', href: '#blog' },
  { name: 'Contact', href: '#contact' },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo/Name -->
      <a href="/" class="flex items-center gap-2 text-xl font-bold text-white hover:text-blue-400 transition-all duration-300 header-text hover-scale">
        <img src="/favicon.png" alt="Logo" class="w-8 h-8 transition-transform duration-300 hover:rotate-12" />
        <span>Daniel Peláez-Zapata</span>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden md:flex items-center gap-6">
        {navItems.map((item, index) => (
          <li class="animate-fade-in" style={`animation-delay: ${index * 0.1}s`}>
            <a
              href={item.href}
              class="text-white/90 hover:text-blue-400 transition-all duration-300 font-medium header-text relative group"
            >
              {item.name}
              <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-blue-400 transition-all duration-300 group-hover:w-full"></span>
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 text-white/90 hover:text-blue-400 header-text transition-all duration-300 hover-scale"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pt-4 border-t border-slate-200 transition-all duration-300">
      <ul class="flex flex-col gap-3">
        {navItems.map((item, index) => (
          <li class="animate-fade-in" style={`animation-delay: ${index * 0.05}s`}>
            <a
              href={item.href}
              class="block text-slate-600 hover:text-blue-600 transition-all duration-300 font-medium py-2 header-text hover:translate-x-2"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  button?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking a link
  const mobileLinks = menu?.querySelectorAll('a');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });

  // Header scroll effect
  const header = document.getElementById('main-header');
  const headerTexts = document.querySelectorAll('.header-text');

  function updateHeader() {
    if (window.scrollY > 50) {
      header?.classList.add('bg-white/95', 'backdrop-blur-sm', 'border-b', 'border-slate-200', 'shadow-sm');
      // Change text colors to dark when header has background
      headerTexts.forEach(el => {
        el.classList.remove('text-white', 'text-white/90', 'hover:text-blue-400');
        el.classList.add('text-slate-900', 'text-slate-600', 'hover:text-blue-600');
      });
    } else {
      header?.classList.remove('bg-white/95', 'backdrop-blur-sm', 'border-b', 'border-slate-200', 'shadow-sm');
      // Change text colors back to white when header is transparent
      headerTexts.forEach(el => {
        el.classList.remove('text-slate-900', 'text-slate-600', 'hover:text-blue-600');
        el.classList.add('text-white', 'text-white/90', 'hover:text-blue-400');
      });
    }
  }

  // Initial check
  updateHeader();

  // Listen to scroll events
  window.addEventListener('scroll', updateHeader);
</script>
