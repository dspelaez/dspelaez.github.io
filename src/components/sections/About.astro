---
import { getLang, useTranslations, colon } from '../../i18n/ui';
import { bio, researchInterests, education } from '../../i18n/about';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const paragraphs = bio[lang];
const interests = researchInterests[lang];
const degrees = education[lang];

// Icon components - larger for timeline
const icons = {
  phd: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5" /></svg>',
  masters: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" /></svg>',
  bachelor: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>',
  // Research interest icons from Lucide (https://lucide.dev)
  waves: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-blue-500 transition-transform duration-300 hover:scale-110"><path stroke-linecap="round" stroke-linejoin="round" d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" /><path stroke-linecap="round" stroke-linejoin="round" d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" /><path stroke-linecap="round" stroke-linejoin="round" d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1" /></svg>',
  wind: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-cyan-500 transition-transform duration-300 hover:scale-110"><path stroke-linecap="round" stroke-linejoin="round" d="M12.8 19.6A2 2 0 1 0 14 16H2" /><path stroke-linecap="round" stroke-linejoin="round" d="M17.5 8a2.5 2.5 0 1 1 2 4H2" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.8 4.4A2 2 0 1 1 11 8H2" /></svg>',
  turbulence: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-indigo-500 transition-transform duration-300 hover:scale-110"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 3v5h-5" /><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" /><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H3v5" /></svg>',
  bubbles: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-teal-500 transition-transform duration-300 hover:scale-110"><path stroke-linecap="round" stroke-linejoin="round" d="M7.2 14.8a2 2 0 0 1 2 2" /><circle stroke-linecap="round" stroke-linejoin="round" cx="18.5" cy="8.5" r="3.5" /><circle stroke-linecap="round" stroke-linejoin="round" cx="7.5" cy="16.5" r="5.5" /><circle stroke-linecap="round" stroke-linejoin="round" cx="7.5" cy="4.5" r="2.5" /></svg>',
  sensors: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-green-500 transition-transform duration-300 hover:scale-110"><path stroke-linecap="round" stroke-linejoin="round" d="m13.5 6.5-3.148-3.148a1.205 1.205 0 0 0-1.704 0L6.352 5.648a1.205 1.205 0 0 0 0 1.704L9.5 10.5" /><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 7.5 19 5" /><path stroke-linecap="round" stroke-linejoin="round" d="m17.5 10.5 3.148 3.148a1.205 1.205 0 0 1 0 1.704l-2.296 2.296a1.205 1.205 0 0 1-1.704 0L13.5 14.5" /><path stroke-linecap="round" stroke-linejoin="round" d="M9 21a6 6 0 0 0-6-6" /><path stroke-linecap="round" stroke-linejoin="round" d="M9.352 10.648a1.205 1.205 0 0 0 0 1.704l2.296 2.296a1.205 1.205 0 0 0 1.704 0l4.296-4.296a1.205 1.205 0 0 0 0-1.704l-2.296-2.296a1.205 1.205 0 0 0-1.704 0z" /></svg>',
  modeling: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-purple-500 transition-transform duration-300 hover:scale-110"><rect stroke-linecap="round" stroke-linejoin="round" width="20" height="14" x="2" y="3" rx="2" /><line stroke-linecap="round" stroke-linejoin="round" x1="8" x2="16" y1="21" y2="21" /><line stroke-linecap="round" stroke-linejoin="round" x1="12" x2="12" y1="17" y2="21" /></svg>'
};
---

<section id="about" class="py-20 bg-white dark:bg-slate-800">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Section Title -->
      <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-12 text-center scroll-animate">
        {t('about.title')}
      </h2>

      <!-- Bio: two short boxes, what I do / my path -->
      <div class="max-w-5xl mx-auto mb-16 grid md:grid-cols-2 gap-6">
        {[
          { title: t('about.what'), text: paragraphs.what, icon: '<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>' },
          { title: t('about.path'), text: paragraphs.path, icon: '<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>' },
        ].map((box) => (
          <div class="scroll-animate bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg p-6">
            <h3 class="flex items-center gap-2 text-lg font-semibold text-blue-600 dark:text-blue-400 mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true" set:html={box.icon} />
              {box.title}
            </h3>
            <p class="text-slate-700 dark:text-slate-300 leading-relaxed">{box.text}</p>
          </div>
        ))}
      </div>

      <!-- Research Interests - Below -->
      <div class="max-w-5xl mx-auto mb-16">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-8 text-center">
          {t('about.interests')}
        </h3>
        <div class="grid md:grid-cols-2 gap-8">
          {interests.map((interest, index) => {
            const iconHtml = icons[interest.icon as keyof typeof icons] || icons.waves;
            return (
              <div class="flex gap-4 items-start scroll-animate" style={`animation-delay: ${index * 0.05}s`}>
                <span class="flex-shrink-0 mt-1" set:html={iconHtml}></span>
                <div class="flex-1">
                  <div class="text-slate-900 dark:text-white font-semibold">{interest.title}{colon(lang)}</div>
                  <div class="text-slate-700 dark:text-slate-300 leading-relaxed">{interest.description}</div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Education Timeline -->
      <div class="max-w-3xl mx-auto">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-12 text-center">{t('about.education')}</h3>
        <div class="relative">
          <!-- Vertical timeline line -->
          <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-0.5 bg-blue-300 dark:bg-blue-700"></div>

          <!-- Timeline items - compact spacing -->
          <div class="space-y-3">
            {degrees.map((edu, index) => {
              const iconHtml = icons[edu.icon as keyof typeof icons] || icons.bachelor;
              const isEven = index % 2 === 0;
              return (
                <div class={`relative flex items-center ${isEven ? 'justify-start' : 'justify-end'} scroll-animate`} style={`animation-delay: ${index * 0.1}s`}>
                  {/* Content card */}
                  <div class={`w-5/12 ${isEven ? 'pr-8 text-right' : 'pl-8 text-left'}`}>
                    <div class="bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg shadow-md hover-lift border border-slate-200 dark:border-slate-600">
                      <h4 class="text-base font-semibold text-slate-900 dark:text-white mb-1">{edu.degree}</h4>
                      <p class="text-sm text-slate-600 dark:text-slate-400">{edu.institution}</p>
                      <p class="text-xs text-slate-600 dark:text-slate-400">{edu.location}</p>
                    </div>
                  </div>

                  {/* Icon circle - centered on timeline */}
                  <div class="absolute left-1/2 transform -translate-x-1/2 w-16 h-16 bg-white dark:bg-slate-800 rounded-full border-4 border-blue-500 dark:border-blue-400 flex items-center justify-center text-blue-600 dark:text-blue-400 shadow-lg hover-scale z-10" set:html={iconHtml}>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
