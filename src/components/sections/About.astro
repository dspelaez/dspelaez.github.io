---

<section id="about" class="py-20 bg-white dark:bg-slate-800">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Section Title -->
      <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-12 text-center scroll-animate">
        About Me
      </h2>

      <!-- Bio and Research Interests - Side by Side -->
      <div class="max-w-6xl mx-auto mb-16">
        <div class="grid md:grid-cols-2 gap-8 items-stretch">
          <!-- Left: About Me paragraph -->
          <div class="scroll-animate-left flex">
            <div class="bg-slate-50 dark:bg-slate-700/50 p-8 rounded-lg shadow-md hover-lift border border-slate-200 dark:border-slate-600 flex items-center w-full">
              <p class="text-slate-700 dark:text-slate-300 leading-relaxed text-lg">
                I am a physical oceanographer studying air–sea interactions, with a focus on
                ocean wave dynamics. My research combines field observations, remote sensing,
                and numerical modelling to understand how waves are generated, evolve, and
                dissipate, and how they influence ocean–atmosphere exchanges and climate
                processes.
              </p>
            </div>
          </div>

          <!-- Right: Research Interests -->
          <div class="scroll-animate-right flex flex-col">
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">
              Research Interests
            </h3>
            <ul class="space-y-4 flex-1">
              {researchInterests.map((interest, index) => {
                const iconHtml = icons[interest.icon as keyof typeof icons] || icons.waves;
                return (
                  <li class="flex gap-3 items-start scroll-animate hover-lift" style={`animation-delay: ${index * 0.05}s`}>
                    <span class="flex-shrink-0 mt-1" set:html={iconHtml}></span>
                    <div class="flex-1">
                      <div class="text-slate-900 dark:text-white font-semibold">{interest.title}:</div>
                      <div class="text-slate-700 dark:text-slate-300 leading-relaxed">{interest.description}</div>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </div>

      <!-- Education Timeline -->
      <div class="max-w-3xl mx-auto">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-12 text-center">Education</h3>
        <div class="relative">
          <!-- Vertical timeline line -->
          <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-0.5 bg-blue-300 dark:bg-blue-700"></div>

          <!-- Timeline items - compact spacing -->
          <div class="space-y-3">
            {education.map((edu, index) => {
              const iconHtml = icons[edu.icon as keyof typeof icons] || icons.bachelor;
              const isEven = index % 2 === 0;
              return (
                <div class={`relative flex items-center ${isEven ? 'justify-start' : 'justify-end'} scroll-animate`} style={`animation-delay: ${index * 0.1}s`}>
                  {/* Content card */}
                  <div class={`w-5/12 ${isEven ? 'pr-8 text-right' : 'pl-8 text-left'}`}>
                    <div class="bg-slate-50 dark:bg-slate-700/50 p-4 rounded-lg shadow-md hover-lift border border-slate-200 dark:border-slate-600">
                      <h4 class="text-base font-semibold text-slate-900 dark:text-white mb-1">{edu.degree}</h4>
                      <p class="text-sm text-slate-600 dark:text-slate-400">{edu.institution}</p>
                      <p class="text-xs text-slate-600 dark:text-slate-400">{edu.location}</p>
                    </div>
                  </div>

                  {/* Icon circle - centered on timeline */}
                  <div class="absolute left-1/2 transform -translate-x-1/2 w-16 h-16 bg-white dark:bg-slate-800 rounded-full border-4 border-blue-500 dark:border-blue-400 flex items-center justify-center text-blue-600 dark:text-blue-400 shadow-lg hover-scale z-10" set:html={iconHtml}>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
