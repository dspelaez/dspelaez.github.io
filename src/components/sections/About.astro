  bubbles: '<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-teal-500 transition-transform duration-300 hover:scale-110"><path stroke-linecap="round" stroke-linejoin="round" d="M7.2 14.8a2 2 0 0 1 2 2" /><circle stroke-linecap="round" stroke-linejoin="round" cx="18.5" cy="8.5" r="3.5" /><circle stroke-linecap="round" stroke-linejoin="round" cx="7.5" cy="16.5" r="5.5" /><circle stroke-linecap="round" stroke-linejoin="round" cx="7.5" cy="4.5" r="2.5" /></svg>',
