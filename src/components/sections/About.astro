---
const education = [
  {
    degree: 'PhD. Mathématiques aux interfaces',
    institution: 'Université Paris-Saclay',
    location: 'France',
    icon: 'phd'
  },
  {
    degree: 'PhD. Applied Mathematics',
    institution: 'University College Dublin',
    location: 'Ireland',
    icon: 'phd'
  },
  {
    degree: 'M.Sc. Physical Oceanography',
    institution: 'CICESE',
    location: 'Ensenada, México',
    icon: 'masters'
  },
  {
    degree: 'M.Eng. Water Resources',
    institution: 'Universidad Nacional de Colombia',
    location: 'Medellín',
    icon: 'masters'
  },
  {
    degree: 'B.Sc. Civil Engineering',
    institution: 'Universidad Nacional de Colombia',
    location: 'Medellín',
    icon: 'bachelor'
  },
];

const researchInterests = [
  {
    icon: 'waves',
    title: 'Ocean wave dynamics',
    description: 'Generation, evolution, and dissipation processes'
  },
  {
    icon: 'wind',
    title: 'Air–sea momentum and energy transfer',
    description: 'Coupling between waves, wind, and currents'
  },
  {
    icon: 'turbulence',
    title: 'Upper ocean turbulence',
    description: 'Wave-driven boundary layers and Langmuir circulation'
  },
  {
    icon: 'bubbles',
    title: 'Gas exchange processes',
    description: 'Wave-induced and bubble-mediated air–sea fluxes'
  },
  {
    icon: 'sensors',
    title: 'Observational methods',
    description: 'Ocean acoustics, wave buoys, satellite remote sensing, and radar systems'
  },
  {
    icon: 'modeling',
    title: 'Numerical modeling',
    description: 'SWAN, WAVEWATCH III, Oceananigans.jl, GOTM, etc'
  }
];

// Icon components - larger for timeline
