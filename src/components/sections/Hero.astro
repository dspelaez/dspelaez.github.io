---
---

<section id="hero" class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/bg-masthead.jpg"
      alt="Background"
      class="w-full h-full object-cover"
    />
    <!-- Colored Veil/Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-800/70 via-slate-700/60 to-slate-900/80"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 py-20 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Profile Image -->
      <div class="mb-8">
        <img
          src="/profile.jpg"
          alt="Daniel Peláez-Zapata"
          class="w-40 h-40 rounded-full mx-auto object-cover border-4 border-white shadow-2xl"
        />
      </div>

      <!-- Name and Title -->
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 drop-shadow-lg font-lato" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">
        Daniel Peláez-Zapata
      </h1>

      <p class="text-xl md:text-2xl text-blue-200 font-medium mb-8 drop-shadow font-lato" style="text-shadow: 1px 1px 3px rgba(0,0,0,0.4);">
        Researcher in physical oceanography and air-sea interactions
      </p>



      <!-- Scroll Indicator -->
      <div class="mt-16 animate-bounce">
        <a href="#about" class="inline-block text-white/70 hover:text-white transition-colors">
          <svg class="w-6 h-6 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
