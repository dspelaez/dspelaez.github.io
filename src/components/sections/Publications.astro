---
import PublicationCard from '../PublicationCard.astro';
import { getLang, useTranslations, localizePath, locales, colon, projectText, venueLabel } from '../../i18n/ui';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
import { readFile, writeFile, mkdir } from 'node:fs/promises';
import { resolve } from 'node:path';
import { fetchPublications, generateBibtex } from '../../lib/crossref';

// Configuration
const ORCID = '0000-0001-5862-6194';
const EMAIL = 'dspelaez@ifremer.fr'; // Replace with your email for CrossRef polite pool
const CACHE_PATH = resolve('./public/crossref-publications.json');
const CACHE_DURATION = 7 * 24 * 60 * 60 * 1000; // 7 days in milliseconds

interface Publication {
  title: string;
  authors: string;
  journal: string;
  year: number;
  doi: string;
  url?: string;
  abstract: string;
  citationKey: string;
  itemType: string;
  citationCount?: number;
  bibtex?: string;
}

let publications: Publication[] = [];

try {
  // Try to read cached data
  const cached = await readFile(CACHE_PATH, 'utf-8');
  const cacheData = JSON.parse(cached);

  const cacheAge = Date.now() - cacheData.timestamp;

  if (cacheAge < CACHE_DURATION) {
    // Use cached data if fresh enough
    console.log('Using cached CrossRef data');
    publications = cacheData.publications;
  } else {
    throw new Error('Cache expired');
  }
} catch (error) {
  // Fetch fresh data if cache miss or expired
  try {
    console.log('Fetching fresh data from CrossRef API');
    publications = await fetchPublications(ORCID, EMAIL);

    // Generate BibTeX for each publication
    publications = publications.map(pub => ({
      ...pub,
      bibtex: generateBibtex(pub)
    }));

    // Ensure public directory exists
    await mkdir(resolve('./public'), { recursive: true });

    // Cache the results
    await writeFile(
      CACHE_PATH,
      JSON.stringify({ timestamp: Date.now(), publications }, null, 2)
    );
    console.log('Publications cached successfully');
  } catch (fetchError) {
    console.error('Failed to fetch from CrossRef:', fetchError);
    // Try to use stale cache as fallback
    try {
      const cached = await readFile(CACHE_PATH, 'utf-8');
      const cacheData = JSON.parse(cached);
      publications = cacheData.publications;
      console.log('Using stale cache as fallback');
    } catch {
      console.error('No cached data available');
      publications = [];
    }
  }
}

// Get recent publications (top 4)
const recentPublications = publications.slice(0, 4);
---

<section id="publications" class="py-20 bg-slate-50 dark:bg-slate-900">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Section Title -->
      <div class="text-center mb-12 scroll-animate">
        <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">
          {t('pubs.title')}
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          {t('pubs.subtitle')}
        </p>
      </div>

      <!-- Publications Grid -->
      {recentPublications.length > 0 ? (
        <div class="grid gap-6 mb-10">
          {recentPublications.map((pub: Publication, index: number) => (
            <PublicationCard pub={pub} lang={lang} animateClass="scroll-animate hover-lift" animationDelay={`${index * 0.15}s`} />
          ))}
        </div>

        <!-- View All Link -->
        <div class="text-center scroll-animate">
          <a
            href={localizePath('/publications', lang)}
            class="inline-block px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-all hover-scale hover-lift shadow-md hover:shadow-lg"
          >
            {t('pubs.viewAll')}
          </a>
        </div>
      ) : (
        <p class="text-center text-slate-600 dark:text-slate-400">
          No publications yet. Add content to <code>src/content/publications/</code>
        </p>
      )}
    </div>
  </div>
</section>

