---
import LangBadges from '../LangBadges.astro';
import CoverFallback from '../CoverFallback.astro';
import { getLang, useTranslations, localizePath, locales, colon, projectText, venueLabel } from '../../i18n/ui';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
import { listPosts } from '../../lib/blog';

// Recent posts (limit to 6), in this page's language when translated
const posts = (await listPosts(lang)).slice(0, 6);

const categoryColors = {
  'research-update': 'bg-pink-100 text-pink-700 dark:bg-pink-900 dark:text-pink-300',
  tutorial: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900 dark:text-cyan-300',
};
---

<section id="blog" class="py-20 bg-slate-50 dark:bg-slate-900">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Section Title -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">
          {t('blog.title')}
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          {t('blog.subtitle')}
        </p>
      </div>

      <!-- Blog Posts Carousel -->
      {posts.length > 0 ? (
        <div class="relative mb-10">
          <!-- Carousel Container -->
          <div class="@container overflow-x-auto snap-x snap-mandatory scroll-smooth hide-scrollbar pb-6 px-2 scroll-px-2 blog-carousel-container" id="blog-carousel" style="overflow-y: visible;">
            <div class="flex gap-6 py-4" style="width: max-content;">
              {posts.map(({ post, url, shownLang, versions }, index) => (
                <article class="bg-white dark:bg-slate-800 rounded-lg shadow-md hover:shadow-lg transition-all hover:-translate-y-2 overflow-hidden border border-slate-200 dark:border-slate-700 snap-start blog-carousel-item flex-shrink-0 w-[100cqw] md:w-[calc((100cqw-1.5rem)/2)] lg:w-[calc((100cqw-3rem)/3)] flex flex-col"  data-index={index}>
              <!-- Image -->
              {post.data.image ? (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-48 object-cover"
                />
              ) : (
                <CoverFallback category={post.data.category} />
              )}

              <div class="p-6 flex flex-col flex-1">
                <!-- Category Badge -->
                <div class="mb-3 flex flex-wrap items-center gap-2">
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold uppercase ${categoryColors[post.data.category]}`}>
                    {t(`blog.cat.${post.data.category}`)}
                  </span>
                  <LangBadges versions={versions} current={shownLang} />
                </div>

                <!-- Title -->
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">
                  <a href={url} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                    {post.data.title}
                  </a>
                </h3>

                <!-- Date -->
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
                  {post.data.pubDate.toLocaleDateString(locales[lang], {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </p>

                <!-- Description -->
                <p class="text-slate-600 dark:text-slate-400 mb-4">
                  {post.data.description}
                </p>

                <!-- Tags and Read more stay together at the bottom of the card -->
                <div class="mt-auto flex flex-col">
                  <!-- Tags -->
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-4">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-xs rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <!-- Read More Link -->
                  <a
                    href={url}
                    class="self-start inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium text-sm"
                  >
                    {t('blog.readMore')}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
            </div>
          </div>

          <!-- Carousel controls: previous, indicators, next -->
          <div class="flex justify-center items-center gap-4 mt-6">
            <button
              class="p-2 rounded-full border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors blog-carousel-prev"
              aria-label={t('carousel.prev')}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <div class="flex gap-2">
              {posts.map((_, index) => (
                <button
                  class="blog-carousel-indicator w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-600 transition-all hover:bg-slate-400 dark:hover:bg-slate-500"
                  data-index={index}
                  aria-label={`${t('carousel.goto')} ${index + 1}`}
                ></button>
              ))}
            </div>
            <button
              class="p-2 rounded-full border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors blog-carousel-next"
              aria-label={t('carousel.next')}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- View All Link -->
        <div class="text-center">
          <a
            href={localizePath('/blog', lang)}
            class="inline-block px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg"
          >
            {t('blog.viewAll')}
          </a>
        </div>
      ) : (
        <p class="text-center text-slate-600 dark:text-slate-400">
          No blog posts yet. Add content to <code>src/content/blog/</code>
        </p>
      )}
    </div>
  </div>
</section>

<script>
  import { initCarousel } from '../../scripts/carousel';
  initCarousel('blog');
</script>
