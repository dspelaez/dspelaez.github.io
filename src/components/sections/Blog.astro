---
import { getCollection } from 'astro:content';

// Get recent blog posts (limit to 6)
const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 6);

const categoryColors = {
  python: 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300',
  modelling: 'bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300',
  'data-analysis': 'bg-orange-100 text-orange-700 dark:bg-orange-900 dark:text-orange-300',
  'research-update': 'bg-pink-100 text-pink-700 dark:bg-pink-900 dark:text-pink-300',
  tutorial: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900 dark:text-cyan-300',
};
---

<section id="blog" class="py-20 bg-slate-50 dark:bg-slate-900">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Section Title -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Blog & Tutorials
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          Technical guides, research updates, and insights
        </p>
      </div>

      <!-- Blog Posts Carousel -->
      {posts.length > 0 ? (
        <div class="relative mb-10">
          <!-- Previous Button -->
          <button
            class="absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-white dark:bg-slate-800 text-slate-900 dark:text-white p-3 rounded-full shadow-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-all opacity-90 hover:opacity-100 blog-carousel-prev"
            aria-label="Previous"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <!-- Next Button -->
          <button
            class="absolute right-0 top-1/2 -translate-y-1/2 z-10 bg-white dark:bg-slate-800 text-slate-900 dark:text-white p-3 rounded-full shadow-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-all opacity-90 hover:opacity-100 blog-carousel-next"
            aria-label="Next"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Carousel Container -->
          <div class="overflow-x-auto snap-x snap-mandatory scroll-smooth hide-scrollbar pb-6 blog-carousel-container" id="blog-carousel" style="overflow-y: visible;">
            <div class="flex gap-6 py-4" style="width: max-content;">
              {posts.map((post, index) => (
                <article class="bg-white dark:bg-slate-800 rounded-lg shadow-md hover:shadow-lg transition-all hover:-translate-y-2 overflow-hidden border border-slate-200 dark:border-slate-700 snap-center blog-carousel-item" style="width: 380px; max-width: 90vw;" data-index={index}>
              <!-- Image -->
              {post.data.image && (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-48 object-cover"
                />
              )}

              <div class="p-6">
                <!-- Category Badge -->
                <div class="mb-3">
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold uppercase ${categoryColors[post.data.category]}`}>
                    {post.data.category.replace('-', ' ')}
                  </span>
                </div>

                <!-- Title -->
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">
                  {post.data.title}
                </h3>

                <!-- Date -->
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </p>

                <!-- Description -->
                <p class="text-slate-600 dark:text-slate-400 mb-4">
                  {post.data.description}
                </p>

                <!-- Tags -->
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-xs rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Read More Link -->
                <a
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium text-sm"
                >
                  Read more
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
            </div>
          </div>

          <!-- Carousel Indicators -->
          <div class="flex justify-center gap-2 mt-6">
            {posts.map((_, index) => (
              <button
                class="blog-carousel-indicator w-2 h-2 rounded-full bg-slate-300 dark:bg-slate-600 transition-all hover:bg-slate-400 dark:hover:bg-slate-500"
                data-index={index}
                aria-label={`Go to slide ${index + 1}`}
              ></button>
            ))}
          </div>
        </div>

        <!-- View All Link -->
        <div class="text-center">
          <a
            href="/blog"
            class="inline-block px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg"
          >
            View All Posts
          </a>
        </div>
      ) : (
        <p class="text-center text-slate-600 dark:text-slate-400">
          No blog posts yet. Add content to <code>src/content/blog/</code>
        </p>
      )}
    </div>
  </div>
</section>

<script>
  // Blog Carousel Auto-scroll
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('blog-carousel');
    const items = document.querySelectorAll('.blog-carousel-item');
    const indicators = document.querySelectorAll('.blog-carousel-indicator');
    const prevBtn = document.querySelector('.blog-carousel-prev');
    const nextBtn = document.querySelector('.blog-carousel-next');

    if (!carousel || items.length === 0) return;

    let currentIndex = 0;
    let autoScrollInterval;
    const AUTO_SCROLL_DELAY = 5000; // 5 seconds

    // Scroll to specific item
    function scrollToItem(index) {
      if (index < 0 || index >= items.length) return;

      currentIndex = index;
      const item = items[index];
      const itemWidth = item.offsetWidth;
      const gap = 24; // 6 * 4px (gap-6)
      const scrollPosition = (itemWidth + gap) * index;

      carousel.scrollTo({
        left: scrollPosition,
        behavior: 'smooth'
      });

      // Update indicators
      updateIndicators();
    }

    // Update indicator styles
    function updateIndicators() {
      indicators.forEach((indicator, index) => {
        if (index === currentIndex) {
          indicator.classList.remove('bg-slate-300', 'dark:bg-slate-600');
          indicator.classList.add('bg-blue-600', 'dark:bg-blue-500', 'w-8');
        } else {
          indicator.classList.remove('bg-blue-600', 'dark:bg-blue-500', 'w-8');
          indicator.classList.add('bg-slate-300', 'dark:bg-slate-600');
        }
      });
    }

    // Next slide
    function nextSlide() {
      const nextIndex = (currentIndex + 1) % items.length;
      scrollToItem(nextIndex);
    }

    // Previous slide
    function prevSlide() {
      const prevIndex = (currentIndex - 1 + items.length) % items.length;
      scrollToItem(prevIndex);
    }

    // Start auto-scroll
    function startAutoScroll() {
      stopAutoScroll();
      autoScrollInterval = setInterval(nextSlide, AUTO_SCROLL_DELAY);
    }

    // Stop auto-scroll
    function stopAutoScroll() {
      if (autoScrollInterval) {
        clearInterval(autoScrollInterval);
        autoScrollInterval = null;
      }
    }

    // Event listeners
    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        stopAutoScroll();
        startAutoScroll(); // Restart after manual interaction
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        stopAutoScroll();
        startAutoScroll(); // Restart after manual interaction
      });
    }

    indicators.forEach((indicator) => {
      indicator.addEventListener('click', () => {
        const index = parseInt(indicator.dataset.index);
        scrollToItem(index);
        stopAutoScroll();
        startAutoScroll(); // Restart after manual interaction
      });
    });

    // Pause on hover
    carousel.addEventListener('mouseenter', stopAutoScroll);
    carousel.addEventListener('mouseleave', startAutoScroll);

    // Handle manual scroll
    let scrollTimeout;
    carousel.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        // Detect which item is most visible
        const scrollLeft = carousel.scrollLeft;
        const itemWidth = items[0].offsetWidth;
        const gap = 24;
        const newIndex = Math.round(scrollLeft / (itemWidth + gap));

        if (newIndex !== currentIndex && newIndex >= 0 && newIndex < items.length) {
          currentIndex = newIndex;
          updateIndicators();
        }
      }, 150);
    });

    // Initialize
    updateIndicators();
    startAutoScroll();
  });
</script>
