---
import { getCollection } from 'astro:content';

// Get recent blog posts (limit to 3)
const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const categoryColors = {
  python: 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300',
  swan: 'bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300',
  ww3: 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300',
  'data-analysis': 'bg-orange-100 text-orange-700 dark:bg-orange-900 dark:text-orange-300',
  'research-update': 'bg-pink-100 text-pink-700 dark:bg-pink-900 dark:text-pink-300',
  tutorial: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900 dark:text-cyan-300',
};
---

<section id="blog" class="py-20 bg-slate-50 dark:bg-slate-900">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Section Title -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Blog & Tutorials
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          Technical guides, research updates, and insights
        </p>
      </div>

      <!-- Blog Posts Carousel -->
      {posts.length > 0 ? (
        <div class="relative mb-10">
          <!-- Carousel Container -->
          <div class="overflow-x-auto snap-x snap-mandatory scroll-smooth hide-scrollbar pb-4" id="blog-carousel">
            <div class="flex gap-6" style="width: max-content;">
              {posts.map((post) => (
                <article class="bg-white dark:bg-slate-800 rounded-lg shadow-md hover:shadow-lg transition-all hover:-translate-y-1 overflow-hidden border border-slate-200 dark:border-slate-700 snap-center" style="width: 380px; max-width: 90vw;">
              <!-- Image -->
              {post.data.image && (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-48 object-cover"
                />
              )}

              <div class="p-6">
                <!-- Category Badge -->
                <div class="mb-3">
                  <span class={`px-3 py-1 rounded-full text-xs font-semibold uppercase ${categoryColors[post.data.category]}`}>
                    {post.data.category.replace('-', ' ')}
                  </span>
                </div>

                <!-- Title -->
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">
                  {post.data.title}
                </h3>

                <!-- Date -->
                <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </p>

                <!-- Description -->
                <p class="text-slate-600 dark:text-slate-400 mb-4">
                  {post.data.description}
                </p>

                <!-- Tags -->
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mb-4">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="px-2 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-xs rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <!-- Read More Link -->
                <a
                  href={`/blog/${post.id}`}
                  class="inline-flex items-center gap-1 text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-medium text-sm"
                >
                  Read more
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
            </div>
          </div>

          <!-- Navigation Hint -->
          <div class="text-center mt-4 text-sm text-slate-500 dark:text-slate-400">
            ← Scroll to see more →
          </div>
        </div>

        <!-- View All Link -->
        <div class="text-center">
          <a
            href="/blog"
            class="inline-block px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg"
          >
            View All Posts
          </a>
        </div>
      ) : (
        <p class="text-center text-slate-600 dark:text-slate-400">
          No blog posts yet. Add content to <code>src/content/blog/</code>
        </p>
      )}
    </div>
  </div>
</section>
