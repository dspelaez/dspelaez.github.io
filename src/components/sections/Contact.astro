---

<section id="contact" class="py-20 bg-white dark:bg-slate-800">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Section Title -->
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">
          Get in Touch
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-400">
          Connect with me on various platforms
        </p>
      </div>

      <!-- Contact Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
        {contacts.map((contact) => (
          <a
            href={contact.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`${contact.color} text-white rounded-lg p-6 transition-all hover:scale-105 hover:shadow-lg flex flex-col items-center text-center`}
          >
            <svg class="w-8 h-8 mb-3" fill="currentColor" viewBox="0 0 24 24">
              <path d={contact.icon} />
            </svg>
            <h3 class="font-semibold text-lg mb-1">{contact.name}</h3>
            <p class="text-sm opacity-90">{contact.value}</p>
          </a>
        ))}
      </div>

      <!-- Additional Info -->
      <div class="text-center bg-slate-50 dark:bg-slate-900 rounded-lg p-8">
        <h3 class="text-xl font-semibold text-slate-900 dark:text-white mb-3">
          Collaboration & Opportunities
        </h3>
        <p class="text-slate-600 dark:text-slate-400 mb-6">
          I'm always interested in collaborating on research projects,
          consulting opportunities, or discussing ocean science. Feel free to reach out!
        </p>
        <a
          href="mailto:daniel.pelaez_zapata@ens-paris-saclay.fr"
          class="inline-block px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors shadow-md hover:shadow-lg"
        >
          Send Email
        </a>
      </div>
    </div>
  </div>
</section>
