---
import '../styles/global.css';
import { getLang, isTranslatedPage, localizePath, langs, locales, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate?: Date;
  /** 'article' for blog posts, 'website' otherwise */
  type?: 'website' | 'article';
  /** schema.org structured data (one object or several) */
  jsonLd?: object | object[];
  /** URLs of this page in each language, for pages outside the translated set (blog posts) */
  translations?: Partial<Record<Lang, string>>;
}

const { title, description, image, pubDate, type = 'website', jsonLd, translations } = Astro.props;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Escape "<" so the JSON can't close the script tag
const toJson = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : new URL('/og-image.jpg', Astro.site);

// Language and, for pages that exist in every language, their alternates
const lang = getLang(Astro.url);
const alternates = translations
  ? Object.keys(translations).length > 1
    ? (Object.entries(translations) as [Lang, string][]).map(([l, href]) => ({ lang: l, href: new URL(href, Astro.site) }))
    : []
  : isTranslatedPage(Astro.url.pathname)
    ? langs.map((l) => ({ lang: l, href: new URL(localizePath(Astro.url.pathname, l), Astro.site) }))
    : [];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.lang === defaultLang)?.href} />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    {type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta property="og:site_name" content="Daniel Peláez-Zapata" />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />

    <!-- Structured data (schema.org) -->
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={toJson(item)} />)}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&family=JetBrains+Mono&display=swap" rel="stylesheet" />

    <!-- Theme: the visitor's choice (theme toggle) or, by default, the system setting.
         Runs before the page paints to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var media = window.matchMedia('(prefers-color-scheme: dark)');
        var apply = function (dark) { document.documentElement.classList.toggle('dark', dark); };
        apply(stored ? stored === 'dark' : media.matches);
        // Follow system changes while the visitor hasn't picked a theme
        media.addEventListener('change', function (e) {
          var pick = null;
          try { pick = localStorage.getItem('theme'); } catch (err) {}
          if (!pick) apply(e.matches);
        });
      })();
    </script>
  </head>
  <body class="bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100 font-[Lato] antialiased">
    <slot />
  </body>
</html>
