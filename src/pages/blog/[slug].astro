---
import { getCollection } from 'astro:content';
import PostPage from '../../views/PostPage.astro';
import { postLang, postName } from '../../lib/blog';

// English posts at /blog/<name>/ (old /blog/<name>.md/ URLs redirect, see astro.config)
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => postLang(post) === 'en')
    .map((post) => ({ params: { slug: postName(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<PostPage post={post} />
